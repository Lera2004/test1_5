function sendResultToEmail(score100, timeFormatted, statusText) {
    const mistakesFormatted = game.wrongList.length > 0 
        ? game.wrongList.map((m, i) => `${i+1}. ${m.q}\n   Студент: ${m.userAns}\n   Правильно: ${m.correctAns}`).join("\n\n")
        : "Помилок немає! Все виконано ідеально.";

    fetch("https://formspree.io/f/moevpkvr", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Accept": "application/json" },
        body: JSON.stringify({
            student_name: game.userName,
            score_100: score100 + " / 100 балів",
            xp: game.xp,
            time: timeFormatted,
            status: statusText,
            correct_count: game.correctCount + " із " + game.totalTasks,
            mistakes_detail: mistakesFormatted
        })
    })
    .then(res => {
        const emailStatus = document.getElementById("emailStatus");
        if(res.ok) {
            if(emailStatus) emailStatus.innerHTML = "✓ Результати успішно збережено та відправлено викладачу.";
        } else {
            if(emailStatus) emailStatus.innerHTML = "⚠️ Помилка надсилання форми Formspree.";
        }
    })
    .catch(() => {
        const emailStatus = document.getElementById("emailStatus");
        if(emailStatus) emailStatus.innerHTML = "⚠️ Мережева помилка при відправці реквізитів.";
    });
}

function showGameOver() {
    clearInterval(game.timer);
    const seconds = Math.floor((Date.now() - game.startTime) / 1000);
    const timeFormatted = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2,"0")}`;
    const score100 = calculate100Score();

    sendResultToEmail(score100, timeFormatted, "СИСТЕМА ПОШКОДЖЕНА (Game Over)");

    gameEl.innerHTML = `
        <div class="final">
            <div class="final-icon">⚠️</div>
