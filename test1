                <div class="badge-final">⏱ Час: ${timeFormatted}</div>
            </div>

            ${renderDetailedResultsHTML()}

            <p id="emailStatus" style="color:#34d399;font-size:11px;margin-top:10px;">Відправка результатів...</p>
            <button class="btn" onclick="location.reload()" style="margin-top:10px;">🔄 Пройти ще раз</button>
        </div>
    `;
}

function startTimer() {
    game.timer = setInterval(() => {
        const seconds = Math.floor((Date.now() - game.startTime) / 1000);
        timerEl.textContent = `${String(Math.floor(seconds / 60)).padStart(2,"0")}:${String(seconds % 60).padStart(2,"0")}`;
    }, 1000);
}

document.getElementById("startBtn").onclick = () => {
    const nameInput = document.getElementById("userNameInput").value.trim();
    if(!nameInput) {
        alert("Введіть ПІБ!");
        return;
    }
    game.userName = nameInput;
    document.getElementById("userDisplayName").textContent = "👤 " + nameInput;
    document.getElementById("startModal").style.display = "none";

    game.startTime = Date.now();
    updateStats();
    updateLevelTabs();
    renderQuestion();
    startTimer();
};
</script>

</body>
</html>
